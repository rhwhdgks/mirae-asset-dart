{"$defs":{"ActivationPredicate":{"additionalProperties":false,"description":"A boolean answer-root gate for a projected field.\n\nThe answer-root and plan-value authorities are embedded in the execution\nplan, so this contract stores only the typed answer-root reference and the\nexpected boolean.  The envelope closes the reference through those\nauthorities before hand-off.","properties":{"expected_boolean":{"title":"Expected Boolean","type":"boolean"},"predicate_answer_root_ref":{"maxLength":256,"minLength":1,"title":"Predicate Answer Root Ref","type":"string"}},"required":["predicate_answer_root_ref","expected_boolean"],"title":"ActivationPredicate","type":"object"},"AnswerGroup":{"additionalProperties":false,"properties":{"group_id":{"maxLength":256,"minLength":1,"title":"Group Id","type":"string"},"item_ids":{"items":{"maxLength":256,"minLength":1,"type":"string"},"minItems":1,"title":"Item Ids","type":"array"}},"required":["group_id","item_ids"],"title":"AnswerGroup","type":"object"},"AnswerProjection":{"additionalProperties":false,"properties":{"fields":{"items":{"$ref":"#/$defs/ProjectionField"},"title":"Fields","type":"array"},"presentation":{"default":"auto","enum":["auto","prose","table","list"],"title":"Presentation","type":"string"},"projection_mode":{"default":"named_fields","enum":["named_fields","whole_target"],"title":"Projection Mode","type":"string"},"shape":{"enum":["scalar","record","record_list","comparison","timeline","narrative","verdict"],"title":"Shape","type":"string"},"sort":{"anyOf":[{"items":{"maxLength":256,"minLength":1,"type":"string"},"type":"array"},{"type":"null"}],"default":null,"title":"Sort"},"whole_target":{"anyOf":[{"$ref":"#/$defs/WholeTargetBinding"},{"type":"null"}],"default":null}},"required":["shape"],"title":"AnswerProjection","type":"object"},"CompiledAnswerItem":{"additionalProperties":false,"description":"One atomic user promise and its complete field-level coverage.","properties":{"coverage":{"$ref":"#/$defs/CoveragePartition"},"item_id":{"maxLength":256,"minLength":1,"title":"Item Id","type":"string"},"limitation_bindings":{"items":{"$ref":"#/$defs/LimitationBinding"},"title":"Limitation Bindings","type":"array"},"projection":{"$ref":"#/$defs/AnswerProjection"},"status":{"enum":["ready","partial","unavailable"],"title":"Status","type":"string"},"support_requirements":{"items":{"$ref":"#/$defs/SupportRequirement"},"title":"Support Requirements","type":"array"}},"required":["item_id","status","projection","coverage"],"title":"CompiledAnswerItem","type":"object"},"CompiledPremiseContract":{"additionalProperties":false,"description":"Compiler-owned verification contract for a user premise.","properties":{"applies_to_item_ids":{"items":{"maxLength":256,"minLength":1,"type":"string"},"minItems":1,"title":"Applies To Item Ids","type":"array"},"kind":{"enum":["numeric","state","comparison","existence","causal"],"title":"Kind","type":"string"},"premise_id":{"maxLength":256,"minLength":1,"title":"Premise Id","type":"string"},"raw_text":{"minLength":1,"title":"Raw Text","type":"string"},"verdict_requirement":{"const":"required","default":"required","title":"Verdict Requirement","type":"string"},"verification_plan_root_refs":{"items":{"pattern":"^plan-root-[1-9][0-9]*$","type":"string"},"title":"Verification Plan Root Refs","type":"array"},"verification_root_refs":{"items":{"maxLength":256,"minLength":1,"type":"string"},"title":"Verification Root Refs","type":"array"},"verification_task_refs":{"items":{"maxLength":256,"minLength":1,"type":"string"},"title":"Verification Task Refs","type":"array"}},"required":["premise_id","kind","raw_text","applies_to_item_ids"],"title":"CompiledPremiseContract","type":"object"},"CoveragePartition":{"additionalProperties":false,"description":"Coverage sets for a projection's required field IDs.\n\n``qualified`` fields intentionally occur in both ``executable`` and\n``limited``.  The overlap is closed against the projection field binding\nby :class:`Compil